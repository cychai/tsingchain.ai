---
import { nav, site } from '@/data/site';
import { menu } from '@/data/menu';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const under = (p: string) => path === p || path.startsWith(p + '/');
const isCurrent = (n: { href: string; match?: string[] }) => (n.match ?? [n.href]).some(under);
const here = (href: string) => (href === path ? 'page' : undefined);
const sub = (label: string) => `${label}子菜单`;
---
<header class="hdr">
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${site.name} home`}><picture><source type="image/webp" srcset="/brand/logo-360.webp" /><img src="/brand/logo-360.png" alt="清链科技 Tsingchain Global" width="360" height="115" /></picture></a>
    <nav class="nav" aria-label="主导航">
      {nav.map((n, i) => menu[n.href] ? (
        <div class="nav-item" data-dd>
          <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
          <button type="button" class="dd-btn" aria-expanded="false" aria-controls={`dd-${i}`} aria-label={sub(n.label)}><svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg></button>
          <div class:list={['dd', menu[n.href].length > 1 && 'mega']} id={`dd-${i}`}>
            {menu[n.href].map((g) => (
              <div class="dd-g">
                {g.title && <a class="dd-h" href={g.href} aria-current={here(g.href!)}>{g.title}</a>}
                {g.links.map(([href, label]) => <a href={href} aria-current={here(href)}>{label}</a>)}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a href="/company/contact" class="btn hdr-cta">联系我们</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mnav" data-menu data-label-open="关闭" data-label-closed="菜单"><span class="menu-ico" aria-hidden="true"><i></i><i></i><i></i></span><span data-menu-label>菜单</span></button>
  </div>
  <div class="mnav" id="mnav">
    <div class="wrap">
      {nav.map((n) => menu[n.href] ? (
        <div class="mrow">
          <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
          <details name="mnav" open={isCurrent(n)}>
            <summary aria-label={sub(n.label)}><svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg></summary>
            <div class="msub">
              {menu[n.href].map((g) => (
                <>
                  {g.title && <a class="msub-h" href={g.href} aria-current={here(g.href!)}>{g.title}</a>}
                  {g.links.map(([href, label]) => <a href={href} aria-current={here(href)}>{label}</a>)}
                </>
              ))}
            </div>
          </details>
        </div>
      ) : (
        <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href="/company/contact" aria-current={under('/company/contact') ? 'page' : undefined}>联系我们</a>
    </div>
  </div>
  <div class="mnav-scrim" data-menu-scrim hidden></div>
</header>
<script>
  import '@/scripts/site';
</script>
