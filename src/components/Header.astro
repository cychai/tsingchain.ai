---
import { nav, site } from '@/data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const under = (p: string) => path === p || path.startsWith(p + '/');
const isCurrent = (n: { href: string; match?: string[] }) => (n.match ?? [n.href]).some(under);
---
<header class="hdr">
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${site.name} home`}><img src="/brand/logo.png" alt="清链科技 Tsingchain Global" width="2020" height="640" /></a>
    <nav class="nav" aria-label="主导航">
      {nav.map((n) => (
        <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a href="/company/contact" class="btn hdr-cta">联系我们</a>
    <button class="menu-btn" aria-expanded="false" aria-controls="mnav" data-menu>菜单</button>
  </div>
  <div class="mnav" id="mnav">
    <div class="wrap">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/company/contact">联系我们</a>
    </div>
  </div>
</header>
<script>
  const btn = document.querySelector('[data-menu]');
  const m = document.getElementById('mnav');
  btn?.addEventListener('click', () => {
    const open = m?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
    btn.textContent = open ? '关闭' : '菜单';
  });
</script>
