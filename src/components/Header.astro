---
import { nav, site } from '@/data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const under = (p: string) => path === p || path.startsWith(p + '/');
const isCurrent = (n: { href: string; match?: string[] }) => (n.match ?? [n.href]).some(under);
---
<header class="hdr">
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${site.name} home`}><picture><source type="image/webp" srcset="/brand/logo-360.webp" /><img src="/brand/logo-360.png" alt="清链科技 Tsingchain Global" width="360" height="115" /></picture></a>
    <nav class="nav" aria-label="主导航">
      {nav.map((n) => (
        <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a href="/company/contact" class="btn hdr-cta">联系我们</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mnav" data-menu data-label-open="关闭" data-label-closed="菜单"><span class="menu-ico" aria-hidden="true"><i></i><i></i><i></i></span><span data-menu-label>菜单</span></button>
  </div>
  <div class="mnav" id="mnav">
    <div class="wrap">
      {nav.map((n) => <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>)}
      <a href="/company/contact" aria-current={under('/company/contact') ? 'page' : undefined}>联系我们</a>
    </div>
  </div>
  <div class="mnav-scrim" data-menu-scrim hidden></div>
</header>
<script>
  // Mobile menu: a disclosure that locks page scroll while open, closes on Esc (focus returns to the
  // button), on a tap outside, when focus leaves the header, and when the viewport grows to desktop.
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const menu = document.getElementById('mnav');
  const scrim = document.querySelector<HTMLElement>('[data-menu-scrim]');
  const label = btn?.querySelector('[data-menu-label]');
  const hdr = btn?.closest('.hdr');
  if (btn && menu) {
    const isOpen = () => menu.classList.contains('open');
    const set = (open: boolean, refocus = false) => {
      menu.classList.toggle('open', open);
      document.documentElement.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = (open ? btn.dataset.labelOpen : btn.dataset.labelClosed) ?? '';
      if (scrim) scrim.hidden = !open;
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      else if (refocus) btn.focus();
    };
    btn.addEventListener('click', () => set(!isOpen(), true));
    scrim?.addEventListener('click', () => set(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) { e.preventDefault(); set(false, true); } });
    hdr?.addEventListener('focusout', (e) => {
      const to = (e as FocusEvent).relatedTarget as Node | null;
      if (isOpen() && to && !hdr.contains(to)) set(false);
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (e) => { if (e.matches && isOpen()) set(false); });
  }
</script>
