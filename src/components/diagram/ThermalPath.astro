---
/**
 * Diagram 1 — the thermal path: six boundaries on two loops.
 * Words: `bounds` are the page's six boundary titles in page order (B1…B6); `loops` are the two loop names
 * as the page writes them ([facility side, technology side]). Codes B1…B6 match the page's own list counter.
 */
import Frame from './Frame.astro';
import { text, line, rect, head, badge, wave, wrap, layer } from './lib';
interface Props { id?: string; title: string; bounds: string[]; loops: [string, string]; }
const { id = 'dgm-path', title, bounds, loops } = Astro.props;
// Text alternative: built from the same words, nothing added.
const desc = `${loops[1]}: ${[5, 4, 3, 2].map((i) => `B${i + 1} ${bounds[i]}`).join('; ')}. ${loops[0]}: ${[0, 1].map((i) => `B${i + 1} ${bounds[i]}`).join('; ')}.`;

// Stations in heat order: c cold plate (B6), h hoses (B5), m manifold (B4), d CDU (B3), f facility interface (B1), r heat rejection (B2).
type St = { c: number; h: number; m: number; d: number; f: number; r: number };
const order: [keyof St, number][] = [['f', 0], ['r', 1], ['d', 2], ['m', 3], ['h', 4], ['c', 5]];
function art({ c, h, m, d, f, r }: St, dir: number, A: number, B: number) {
  const o = (k: number) => k * dir;
  const mid = (A + B) / 2;
  const q = m - o(26);
  const boxes = [
    rect(c - o(28), A - 2, c - o(16), B + 2, 'ln chip'),
    rect(c - o(16), A - 14, c + o(16), B + 14),
    rect(d - 28, A - 22, d + 28, B + 22),
    rect(r - 20, A - 22, r + 20, B + 22),
  ].join('');
  const pipes = [A, B].map((v) => {
    const cls = v === A ? 'ret' : 'sup';
    return line(`M${c + o(16)} ${v}H${h - o(24)}${wave(h - o(24), h + o(24), v)}M${h + o(24)} ${v}H${d - o(8)}M${d + o(8)} ${v}H${r - o(20)}`, cls);
  }).join('');
  const heads = line(head((m + d) / 2, A, dir, 0) + head((f + r) / 2, A, dir, 0), 'ret') + line(head((m + d) / 2, B, -dir, 0) + head((d + f) / 2, B, -dir, 0), 'sup');
  const glyphs = [
    line([-6, 0, 6].map((k) => `M${c + k} ${A + 4}V${B - 4}`).join(''), 'thin'),
    ...[A, B].flatMap((v) => [
      rect(h - o(24) - 3, v - 5, h - o(24) + 3, v + 5, 'ln box', 1),
      rect(h + o(24) - 3, v - 5, h + o(24) + 3, v + 5, 'ln box', 1),
      rect(m - 5, v - 16, m + 5, v + 16),
      rect(q - 6, v - 5, q - 1, v + 5, 'ln box', 1),
      rect(q + 1, v - 5, q + 6, v + 5, 'ln box', 1),
      line(`M${f - 3} ${v - 6}V${v + 6}M${f + 3} ${v - 6}V${v + 6}`),
    ]),
    line(`M${m - o(5)} ${A - 10}H${m - o(15)}M${m - o(5)} ${B + 10}H${m - o(15)}`),
    rect(d - 8, A - 8, d + 8, B + 8),
    line(`M${d - 8} ${A + 6}L${d + 8} ${A + 19}L${d - 8} ${A + 31}L${d + 8} ${B - 6}`, 'thin'),
    `<circle class="ln box" cx="${d - o(18)}" cy="${B}" r="6"/>`,
    line(head(d - o(21), B, -dir, 0, 3), 'thin'),
    line(`M${f} ${A - 26}V${B + 26}`, 'zone'),
    `<circle class="ln" cx="${r}" cy="${mid}" r="13"/>`,
    line(`M${r} ${mid}v-11M${r} ${mid}l9.5 5.5M${r} ${mid}l-9.5 5.5`, 'thin'),
    line(`M${r + o(20)} ${A}H${r + o(36)}M${r + o(20)} ${B}H${r + o(36)}`, 'ht'),
    line(head(r + o(36), A, dir, 0, 4) + head(r + o(36), B, dir, 0, 4), 'ht solid'),
  ].join('');
  return boxes + pipes + heads + glyphs;
}

// Wide: heat runs left to right.
const W: St = { c: 80, h: 240, m: 400, d: 560, f: 720, r: 880 };
const wA = 132, wB = 182;
const wide = {
  w: 960, h: 290,
  body: layer(art(W, 1, wA, wB), false)
    + line('M52 34V28H556V34M564 34V28H916V34', 'frame')
    + text(304, 19, loops[1], { cls: 't-sub', anchor: 'middle' }) + text(740, 19, loops[0], { cls: 't-sub', anchor: 'middle' })
    + order.map(([k, i]) => badge(W[k], 66, `B${i + 1}`) + line(`M${W[k]} 80V${k === 'h' ? wA - 10 : k === 'm' ? wA - 20 : wA - 26}`, 'frame')
      + text(W[k], wB + 52, wrap(bounds[i], 146), { anchor: 'middle' })).join(''),
};

// Narrow: the facility is at the top, the chip at the bottom; heat runs upward.
const N: St = { r: 70, f: 150, d: 236, m: 322, h: 402, c: 482 };
const nA = 34, nB = 84;
const narrow = {
  w: 340, h: 546,
  body: layer(art(N, -1, nA, nB), true)
    + line('M122 44H116V232H122M122 240H116V512H122', 'frame')
    + text(130, 30, loops[0], { cls: 't-sub' }) + text(130, 532, loops[1], { cls: 't-sub' })
    + order.map(([k, i]) => { const ls = wrap(bounds[i], 166); return badge(142, N[k], `B${i + 1}`) + text(162, N[k] + 4.5 - (ls.length - 1) * 8.5, ls); }).join(''),
};
---
<Frame id={id} title={title} desc={desc} wide={wide} narrow={narrow} />
