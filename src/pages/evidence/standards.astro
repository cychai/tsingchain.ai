---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Related from '@/components/Related.astro';
import Faq from '@/components/Faq.astro';
import { faqs } from '@/data/geo';
import { techArticleLd, faqLd } from '@/lib/ld';
const path = '/evidence/standards';
const qa = faqs[path];
const ld = [techArticleLd(path, { headline: '我们跟踪的标准', description: '清链科技跟踪哪些液冷标准与开放规范，以及为什么我们用的验收准则不该只是我们一家的。' }), faqLd(path, qa)];
---
<Base ld={ld} title="我们跟踪的标准" description="清链科技跟踪哪些液冷标准与开放规范，以及为什么我们用的验收准则不该只是我们一家的。">
  <PageHero eyebrow="交付证据 · 标准" title="我们跟踪的标准" lede="我们跟踪液冷规范的公开草案和已发布版本，公开讨论计量边界，使我们采用的验收准则与行业标准保持一致。" crumbs={[['/evidence', '交付证据']]} />
  <section class="section">
    <div class="wrap prose">
      <h2>我们跟踪的标准与规范</h2>
      <p><strong>开放计算项目（OCP）Cooling Environments。</strong>我们跟踪液冷工作组的公开草案和已发布规范，关注点是调试证据、冷却液品质，以及机柜、CDU 与设施之间的边界。接口正在被写成规范：2026 年 Google 把 Project Deschutes 的 CDU 规范贡献给 OCP；快插接头供应商也提出要更新 2019 年的冷板要求。在我们读过的公开文件里，尚未看到完整规定交付资料包应包含什么的条文，交付资料包正是针对这个空白。这些文件包括 <a href="https://www.opencompute.org/documents/ocp-modular-tcs-rev-1-final-2025-pdf">Modular Technology Cooling System for Cloud Scale</a>（Rev 1，2025 年 8 月）、<a href="https://www.opencompute.org/documents/open-rack-v3-blind-mate-manifold-specification-rev-1-0-review-april05-2024-pdf">Open Rack V3 Blind Mate Manifold Specification</a>（Rev 1.0），以及《Thermal Boundaries in AI Infrastructure》公开征求意见稿（v0.98，2026）。</p>
      <p><strong>能源再利用指标。</strong>让余热利用可审计的指标已经存在：ISO/IEC 30134-6 与 EN 50600-4-6 定义的能源再利用系数（ERF），The Green Grid 作为 PUE 补充发布的能源再利用效率（ERE），以及委员会授权条例 (EU) 2024/1364 对较大规模欧盟数据中心的计量边界要求。我们在自己的报告里使用它们，也建议在项目评估中把 PUE、用水与余热利用指标一起说明。</p>
      <p><strong>国内标准。</strong>冷板式液冷在国内已有一组可以直接引用的行业标准：YD/T 3980-2021《数据中心冷板式液冷服务器系统技术要求和测试方法》、YD/T 3982-2021《数据中心液冷系统冷却液体技术要求和测试方法》、YD/T 6049-2024《冷板式液冷整机柜服务器技术要求和测试方法》、YD/T 6358-2025《冷板式液冷数据中心技术要求》，以及团体标准 T/CIEP 0263-2025《数据中心液冷系统技术规范》；《数据中心冷板式液冷系统技术规范》《数据中心冷板式液冷机柜通用规范》等国家标准已立项。我们的验收准则在这些标准给出的测试方法之上，补的是标准尚未要求的部分：每个边界的记录归属、扰动后的复测，以及余热交接点的计量。</p>
      <p><strong>公开写作。</strong>三个时钟模型、十大漏点和计量边界论证都先以公开文章发布，并在运营方、水化学专家与保险从业者的反馈中公开修订。本站所载为当前版本，随行业讨论持续修订。</p>
      <h2>我们关注的要求</h2>
      <ul>
        <li>每一项性能要求都写明适用的负荷率、温度与边界。</li>
        <li>每一个压力边界都有测试、验收判据和记录责任人。</li>
        <li>清洁度与钝化作为两项要求，各有各的证据。</li>
        <li>余热利用在交接边界上计量，而不是从 IT 负荷估算。</li>
      </ul>
      <Related items={[{ href: '/evidence/commissioning', label: '我们据以调试的验收准则', kind: 'evidence' }, { href: '/insights', label: '准则背后的公开写作', kind: 'insight' }]} />
    </div>
  </section>
  <Faq items={qa} alt />
</Base>
