---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Related from '@/components/Related.astro';
import Definition from '@/components/Definition.astro';
import Faq from '@/components/Faq.astro';
import { definitions, faqs } from '@/data/geo';
import { definedTermLd, techArticleLd, faqLd } from '@/lib/ld';
const stages = [
  { t: '出厂放行前', items: ['每台撬块、分水器与 CDU 按出厂状态做压力与检漏试验，附序列号', '湿路表面清洁度等级以取样验证，而非声明', '弹性体与湿路金属对指定工质的材质证明', '控制系统工厂试运行：泵组投切、阀门行程、传感器校准'] },
  { t: '充液前', items: ['焊缝图完整，每一道现场焊缝检验并记录', '冲洗至清洁度等级；钝化与冲洗分别确认', '所有充注、排放、排气与取样口封堵、挂牌、记录', '整条回路按约定系数与保压时间做压力试验'] },
  { t: '算力上电前', items: ['充液时的工质化学指标符合规格：缓蚀剂、pH、电导率、杀菌剂', '各机柜流量平衡在允差内，逐支路记录', '在可用负荷下实测 CDU 趋近温差，外推方法写明', '算力—液路联动隔离流程实际执行并计时，而不只是评审'] },
  { t: '移交前', items: ['在指定负荷下记录基线：温度、压力、流量、功率', '计量边界画在单线图上并签字', '充液以来的每一次扰动在连接日志中闭环', '交付资料包按十个边界结构整理并编索引'] },
];
const path = '/evidence/commissioning';
const d = definitions[path];
const qa = faqs[path];
const ld = [definedTermLd(path, d), techArticleLd(path, { headline: '调试与验收：从通电到可承载训练', description: '清链科技如何调试液冷系统：开工前写好的验收准则，从出厂放行到移交的分阶段关卡，以及每个关卡的记录。', about: 'term' }), faqLd(path, qa)];
---
<Base ld={ld} title="调试与验收准则" description="清链科技如何调试液冷系统：开工前写好的验收准则，从出厂放行到移交的分阶段关卡，以及每个关卡的记录。">
  <PageHero eyebrow="交付证据 · 准则" title="调试与验收：从通电到可承载训练" lede="一个液冷机房可以通电、可以通过巡检，却仍然没准备好承载一次训练任务。差的是一套开工前约定、分关卡逐项测试的验收准则。" crumbs={[['/approach', '技术与证据'], ['/evidence', '交付证据']]} />
  <Definition d={d} />
  <section class="section">
    <div class="wrap">
      <div class="grid c2">
        {stages.map((s, i) => (
          <div class="card">
            <span class="num">第 {i + 1} 关</span>
            <h3>{s.t}</h3>
            <ul style="margin:0.5rem 0 0;padding-left:1.2em;color:var(--ink-2);font-size:0.95rem">{s.items.map((it) => <li style="margin-bottom:0.4rem">{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap prose">
      <h2>关卡背后的三条原则</h2>
      <p><strong>准则在开工前写好。</strong>试验之后才约定的验收判据，是对已发生事情的描述；之前约定的才是规格。我们把数字写进合同，而不是写进竣工报告。</p>
      <p><strong>被扰动的边界就是要重测的边界。</strong>回路不是一次通过就完事。压力试验后再插拔的每一个快接、为取样打开的每一个接口，都会让该边界的状态归零，直到再次记录。</p>
      <p><strong>每个数字的边界都写明。</strong>负荷率、环境温度、计量点与统计周期随读数一起进记录。没有这些的数字与任何东西都无法比较，包括一年后的它自己。</p>
      <Related items={[{ href: '/evidence/turnover', label: '关卡产出的交付资料包', kind: 'evidence' }, { href: '/approach/three-clocks', label: '为什么调试是独立的一个时钟', kind: 'approach' }, { href: '/services/commissioning', label: '调试作为独立服务', kind: 'approach' }]} />
    </div>
  </section>
  <Faq items={qa} />
</Base>
