---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/data/site';
import { people } from '@/data/team';
import { personLd, PEOPLE_IDS } from '@/lib/ld';
const ld = people.map((p) => { const cn = p.name.split(' ')[0]; return personLd({ id: PEOPLE_IDS[cn] ?? cn, name: cn, alternateName: p.name === cn ? [] : [p.name.replace(cn, '').trim()], jobTitle: p.role, description: p.bio, image: p.photo, sameAs: p.linkedin ? [p.linkedin] : [] }); });
---
<Base ld={ld} title="核心团队" description="清链科技的创始人与负责人。">
  <PageHero eyebrow="关于我们" title="核心团队" lede="清链科技的创始人与负责人。" crumbs={[['/company/about', '关于我们']]} />
  <section class="section">
    <div class="wrap">
      {people.map((p) => (
        <article class="person">
          <div class="photo">{p.photo ? <img src={p.photo} alt={`${p.name} 照片`} width="480" height="480" loading="eager" /> : <span class="initial" aria-hidden="true">{p.name.slice(0, 1)}</span>}</div>
          <div>
            <h2 style="margin-bottom:0.2rem">{p.name}</h2>
            <p class="eyebrow plain" style="margin:0 0 1rem">{p.role}</p>
            <p class="prose">{p.bio}</p>
            <p>{p.linkedin && <><a href={p.linkedin}>LinkedIn</a> · <a href={site.substack}>Every Watt Counts</a> · </>}<a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
<style>
  .person { display: grid; grid-template-columns: 1fr; gap: 2rem; max-width: 900px; }
  @media (min-width: 700px) { .person { grid-template-columns: 220px 1fr; } }
  .photo { width: 220px; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--paper-2); border: 1px solid var(--line); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo .initial { display: grid; place-items: center; width: 100%; height: 100%; font-size: 4rem; font-weight: 700; color: var(--blue); background: var(--paper-2); }
  .person + .person { margin-top: 3rem; }
</style>
