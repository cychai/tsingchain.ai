---
import Base from '@/layouts/Base.astro';
import { news, newsDate, fmtNewsDate, newsPlain, isPara, isH2, type NewsItem } from '@/data/news';
import { newsArticleLd } from '@/lib/ld';
export function getStaticPaths() {
  return news.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}
const { n } = Astro.props as { n: NewsItem };
const path = `/company/news/${n.slug}`;
const published = newsDate(n.date);
const plain = newsPlain(n);
const ld = [newsArticleLd(path, { headline: n.title, description: n.summary, published, body: plain, image: n.cover?.img })];
const firstImg = n.body.findIndex((b) => typeof b === 'object' && 'img' in b);
const ogImage = n.cover ? { src: n.cover.img, w: n.cover.w, h: n.cover.h, alt: n.cover.alt } : undefined;
---
<Base ld={ld} title={n.title} description={n.summary} type="article" published={published} ogImage={ogImage}>
  <article>
    <header class="hero">
      <div class="narrow">
        <nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span><a href="/company/about">公司</a></span><span><a href="/company/news">新闻</a></span></nav>
        <div class="eyebrow">新闻 · <time datetime={n.date}>{fmtNewsDate(n.date)}</time></div>
        <h1 style="font-size:clamp(1.9rem,4vw,3rem)">{n.title}</h1>
        <p class="lede">{n.summary}</p>
      </div>
    </header>
    <div class="narrow prose news-body">
      {n.body.map((b, i) =>
        isPara(b) ? <p set:html={b} /> :
        isH2(b) ? <h2>{b.h2}</h2> :
        <figure class="news-fig">
          <img src={b.img} alt={b.alt} width={b.w} height={b.h} loading={i === firstImg ? 'eager' : 'lazy'} fetchpriority={i === firstImg ? 'high' : undefined} decoding="async" />
          {b.caption && <figcaption>{b.caption}</figcaption>}
        </figure>
      )}
      {n.links && n.links.length > 0 && (
        <>
          <h2>相关链接</h2>
          <ul>{n.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </>
      )}
      {n.legalAttribution && <p class="small muted">{n.legalAttribution}</p>}
      <hr />
      <p class="small muted">咨询与反馈：<a href="mailto:sales@tsingchain.ai">sales@tsingchain.ai</a>。<a href="/company/news">全部新闻</a>。</p>
    </div>
  </article>
</Base>
<style>
  .news-body { padding-bottom: 3rem; font-size: 1.05rem; }
  .news-body h2 { font-size: 1.3rem; }
  .news-fig { margin: 1.75rem 0; }
  .news-fig img { display: block; width: 100%; height: auto; border-radius: 4px; background: var(--line); }
</style>
