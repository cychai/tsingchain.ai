---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { news, fmtNewsDate } from '@/data/news';
---
<Base title="新闻" description="清链科技公司新闻：北美平台动态、液冷学院、工程工具与展会信息。">
  <PageHero eyebrow="公司 · 新闻" title="新闻" lede="清链科技与北美平台 NextGenergy 的最新动态：培训、工程工具与展会信息。" crumbs={[['/company/about', '公司']]} />
  <section class="section">
    <div class="wrap">
      <ol class="news-list">
        {news.map((n) => (
          <li>
            <a href={`/company/news/${n.slug}`} class:list={[{ 'has-cover': n.cover }]}>
              {n.cover && <img class="cover" src={n.cover.img} alt="" width={n.cover.w} height={n.cover.h} loading="lazy" decoding="async" />}
              <span class="txt">
                <time datetime={n.date}>{fmtNewsDate(n.date)}</time>
                <span class="t">{n.title}</span>
                <span class="s">{n.summary}</span>
                <span class="more">阅读 →</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      {news.some((n) => n.legalAttribution) && <p class="small muted" style="margin-top:2rem">{news.find((n) => n.legalAttribution)?.legalAttribution}</p>}
      <p class="small muted" style="margin-top:2rem">液冷、电力与余热利用的长篇文章请见<a href="/insights">洞察</a>。</p>
    </div>
  </section>
</Base>
<style>
  .news-list { list-style: none; padding: 0; margin: 0; max-width: 54rem; }
  .news-list li { border-top: 1px solid var(--line); }
  .news-list li:last-child { border-bottom: 1px solid var(--line); }
  .news-list a { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.4rem 0; color: inherit; text-decoration: none; }
  .news-list .txt { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .news-list a.has-cover { flex-direction: row; align-items: flex-start; gap: 1.25rem; }
  .news-list .cover { flex: 0 0 9.5rem; width: 9.5rem; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; background: var(--line); }
  @media (max-width: 560px) { .news-list a.has-cover { flex-direction: column; } .news-list .cover { width: 100%; flex-basis: auto; aspect-ratio: 16 / 9; } }
  .news-list time { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .news-list .t { font-family: var(--serif); font-size: 1.35rem; font-weight: 600; color: var(--ink); line-height: 1.25; }
  .news-list .s { color: var(--ink-2); font-size: 0.97rem; }
  .news-list .more { font-size: 0.9rem; font-weight: 600; color: var(--water); }
  .news-list a:hover .t, .news-list a:hover .more { color: var(--heat); }
</style>
