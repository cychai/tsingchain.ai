---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '@/data/site';
import { claims } from '@/data/claims';
const latest = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const stats = [
  { c: claims['years-6'], label: '专注液冷，先浸没式、后冷板式' },
  { c: claims['capacity-1000mw'], label: '累计液冷交付' },
  { c: claims['heating-2m'], label: '数据中心余热累计供热面积' },
];
const chain = ['规划', '设计', '预制', '调试', '运维', '余热利用'];
---
<Base title={site.name}>
  <section class="hero home-hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">AI 算力中心液冷 · 北京</div>
          <h1>AI 算力中心的预制化液冷与余热利用</h1>
          <p class="lede">我们规划、设计液冷算力机房，以工厂预制撬块、CDU、机柜和冷却设备交付；也在现场检测、调试和维护液冷回路。每一个交付边界都附带证据。</p>
          <div class="btn-row">
            <a class="btn primary" href="/platform">产品与系统</a>
            <a class="btn" href="/services/field">现场检测与运维</a>
          </div>
        </div>
        <figure class="hero-fig">
          <img src="/products/hero-skid.jpg" alt="预制液冷撬块：钢架上一排液冷机柜，顶部供回水母管与桥架，端部集成 CDU" width="1400" height="933" fetchpriority="high" />
          <figcaption>示意性预制配置，设备与性能按项目确认。图中设备为清链北美平台 NextGenergy 品牌。</figcaption>
        </figure>
      </div>
      <div class="chain" aria-label="我们做什么，按顺序">
        {chain.map((s, i) => <span class="step"><span>{s}</span>{i < chain.length - 1 && <span class="arrow" aria-hidden="true">›</span>}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="eyebrow">我们做什么</div>
      <h2>两件事，每件都有记录。</h2>
      <div class="lines">
        <a class="line" href="/platform">
          <div class="line-img render"><img src="/products/cdu-family.jpg" alt="三台 CDU：机架式、风液式与列间式" loading="lazy" width="1200" height="800" /></div>
          <div class="line-body">
            <span class="num">01</span>
            <h3>预制化液冷系统</h3>
            <p>我们规划、设计液冷 AI 算力中心，把冷却系统按四类产品成套交付，接口和验收准则在制造前约定。自研 CDU 与热回收装置。</p>
            <ul class="chips">
              <li>预制撬块</li><li>ORv3 与 19 英寸机柜</li><li>CDU</li><li>冷却设备</li>
            </ul>
            <span class="more">四类产品 →</span>
          </div>
        </a>
        <a class="line" href="/services/field">
          <div class="line-img photo"><img src="/products/field-tech.jpg" alt="技术人员拿着平板检查液冷管路压力表" loading="lazy" width="621" height="658" /></div>
          <div class="line-body">
            <span class="num">02</span>
            <h3>现场检测、验证与运维</h3>
            <p>面向国内外液冷机房，无论系统是否由我们供货：四道调试关口、书面验收准则，之后是三档运维方案。我们维护的是冷却回路，不是服务器。</p>
            <ul class="chips">
              <li>四道关口</li><li>交付资料包</li><li>三档运维</li><li>L0–L3 分级</li>
            </ul>
            <span class="more">现场服务 →</span>
          </div>
        </a>
      </div>
      <div class="stats" id="figures">
        {stats.map((s) => (
          <div class="stat">
            <span class="v">{s.c.value}</span>
            <span class="l">{s.label}</span>
            <span class="cond"><b>条件：</b>{s.c.condition}</span>
          </div>
        ))}
      </div>
      <p class="small" style="margin-top:1rem"><a href="/cases">这些数字背后的项目 →</a></p>
    </div>
  </section>

  <section class="section ink sim">
    <div class="wrap">
      <div class="split">
        <div>
          <div class="eyebrow">先规划，再建设</div>
          <h2>逐个边界，仿真整条热通路。</h2>
          <p class="lede">选型、规划和设计都要看整个回路：机柜负荷、冷却液温度、CDU 趋近温差、排热方式，以及可以回收的热量。在概念仿真台里选机型、气候和管路布置，就能看到结温、流量、压降和 pPUE 如何稳定下来，再用负载阶跃、泵故障或结垢去考验设计。</p>
          <div class="btn-row">
            <a class="btn ghost" href="https://sim.nextgenergy.ai">打开仿真台</a>
            <a class="btn ghost" href="/tools">全部工程工具</a>
          </div>
          <p class="small" style="color:#9fb0d0;margin-top:1.2rem">概念模型，用于规划和比较；不用于设备选型、验收或性能承诺。</p>
        </div>
        <a class="laptop" href="https://sim.nextgenergy.ai" aria-label="打开液冷仿真台">
          <span class="screen"><img src="/products/simulator.jpg" alt="笔记本电脑上的液冷仿真台：机柜、CDU、干冷器与补冷冷机，实时显示温度、流量与 pPUE" width="1440" height="900" loading="lazy" /></span>
          <span class="base" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="eyebrow">深入了解</div>
      <h2>产品背后的方法与记录。</h2>
      <div class="deeper">
        <a class="deep" href="/solutions"><span class="k">解决方案</span><span class="d">新建、改造、余热利用、极寒气候与边缘部署，各自需要提前定下的事项。</span><span class="more">按项目类型 →</span></a>
        <a class="deep" href="/approach"><span class="k">技术方法</span><span class="d">整条热通路、回水品位，以及漏液风险的三个时钟。</span><span class="more">我们怎么想 →</span></a>
        <a class="deep" href="/evidence"><span class="k">交付证据</span><span class="d">调试准则、交付资料包和十大漏点。</span><span class="more">我们交付什么 →</span></a>
        <a class="deep" href="/insights"><span class="k">洞察</span><span class="d">{latest ? latest.data.title : '关于电力、液冷与余热利用的长文。'}</span><span class="more">最新文章 →</span></a>
      </div>
    </div>
  </section>

  <section class="section ink cta">
    <div class="wrap" style="text-align:center">
      <h2>把您的项目交给我们。</h2>
      <p class="lede" style="margin-inline:auto">新建、改造、余热利用、需要调试的机房，或想请人核验的交付资料包。从系统图、设备清单和已有记录开始即可。</p>
      <div class="btn-row" style="justify-content:center"><a class="btn ghost" href="/company/contact">联系我们</a></div>
    </div>
  </section>
</Base>
<style>
  .deeper { display: grid; gap: 1.25rem; grid-template-columns: 1fr; margin-top: 1.8rem; }
  @media (min-width: 640px) { .deeper { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .deeper { grid-template-columns: repeat(4, 1fr); } }
  .deep { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem; background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r); color: inherit; }
  .deep:hover { border-color: var(--ink-3); }
  .deep .k { font-family: var(--serif); font-weight: 600; font-size: 1.2rem; color: var(--ink); }
  .deep .d { color: var(--ink-2); font-size: 0.95rem; }
  .deep .more { margin-top: auto; padding-top: 0.6rem; font-size: 0.9rem; font-weight: 600; color: var(--water); }
  .deep:hover .more { color: var(--heat); }
  .home-hero { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .hero.home-hero h1 { max-width: none; }
  .hero-grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 6fr); gap: 3.5rem; } }
  .hero-fig { margin: 0; }
  .hero-fig { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r); padding: clamp(1rem, 2.5vw, 2rem); }
  .hero-fig img { width: 100%; height: auto; }
  .hero-fig figcaption { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-top: 0.6rem; }
  .chain { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; margin-top: clamp(1.8rem, 3vw, 2.6rem); padding-top: 1.2rem; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }
  .chain .step { display: inline-flex; gap: 0.9rem; align-items: baseline; }
  .chain .arrow { color: var(--heat); }

  .lines { display: grid; gap: 1.5rem; grid-template-columns: 1fr; margin-top: 2rem; }
  @media (min-width: 820px) { .lines { grid-template-columns: 1fr 1fr; } }
  .line { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; color: inherit; }
  .line:hover { border-color: var(--ink-3); }
  .line-img { background: var(--white); aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--line-2); }
  .line-img img { width: 100%; height: 100%; object-fit: cover; }
  .line-img.render { padding: 1.5rem 2rem; }
  .line-img.render img { object-fit: contain; }
  .line-body { padding: 1.8rem 2rem 2rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  @media (max-width: 600px) { .line-body { padding: 1.5rem 1.5rem 1.6rem; } .line-img.render { padding: 1rem 1.25rem; } }
  .line-body .num { font-family: var(--mono); font-size: 0.75rem; color: var(--heat); letter-spacing: 0.1em; }
  .line-body h3 { margin: 0; font-size: 1.3rem; }
  .line-body p { margin: 0; color: var(--ink-2); font-size: 0.97rem; }
  .chips { list-style: none; padding: 0; margin: auto 0 0; padding-top: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips li { font-size: 0.8rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--paper-2); color: var(--ink); }
  .line-body .more { margin-top: 0; padding-top: 0.9rem; font-size: 0.9rem; font-weight: 600; color: var(--water); }
  .line:hover .more { color: var(--heat); }

  .stats { display: grid; gap: 1.5rem 2.5rem; grid-template-columns: 1fr; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(3, 1fr); } }
  .stat .v { display: block; font-family: var(--serif); font-size: 1.7rem; line-height: 1; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; }
  .stat .l { display: block; color: var(--ink-2); font-size: 0.95rem; }
  .stat .cond { display: block; font-size: 0.78rem; line-height: 1.45; color: var(--ink-3); margin-top: 0.45rem; }
  .stat .cond b { color: var(--ink-2); font-weight: 600; }

  .laptop { display: block; width: 100%; max-width: 680px; margin: 0 auto; padding: 0 5%; align-self: center; }
  .laptop .screen { display: block; background: #0b0f17; border: 1px solid #36405a; border-bottom: 0; border-radius: 16px 16px 0 0; padding: 14px 14px 16px; box-shadow: 0 30px 60px -30px rgba(0,0,0,0.7); }
  .laptop .screen img { display: block; width: 100%; height: auto; border-radius: 6px; }
  .laptop .base { display: block; position: relative; height: 16px; margin: 0 -5%; background: linear-gradient(#e6eaf1, #b8c1d1 60%, #8f9ab0); border-radius: 3px 3px 14px 14px; }
  .laptop .base::before { content: ""; position: absolute; left: 50%; top: 0; transform: translateX(-50%); width: 16%; height: 6px; background: #7c879d; border-radius: 0 0 8px 8px; }
  .laptop:hover .screen { border-color: #6f7c9a; }
  @media (min-width: 900px) { .sim .split { align-items: center; } }
  .sim .lede { font-size: 1.05rem; line-height: 1.6; }
</style>
