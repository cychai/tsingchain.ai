---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Card from '@/components/Card.astro';
import { services } from '@/data/sections';
const gates = ['出厂前：工厂放行', '充液前：充液准备', '上电前：功能就绪', '交接前：系统交接'];
const tiers = ['一档 · 日常维护', '二档 · 验证就绪', '三档 · 全生命周期支持'];
---
<Base title="服务" description="液冷回路的现场检测、验证与运维，面向国内外项目，无论系统是否由我们供货；另有热设计、集成、调试与长期支持。">
  <PageHero eyebrow="服务" title="液冷的现场检测、验证与运维。" lede="多供应商的液冷项目，需要有人牵头跨系统调试和接口验证。我们负责接缝：从设施水接口到可维护单元，无论系统是否由我们供货。" />
  <section class="section">
    <div class="wrap">
      <a class="card media wide field" href="/services/field">
        <div class="card-img"><img src="/products/field-tech.jpg" alt="技术人员拿着平板检查液冷管路压力表" width="621" height="658" loading="eager" /></div>
        <div class="card-body field-body">
          <div class="eyebrow">现场服务</div>
          <h2>面向冷却回路（而非服务器）的调试关口与运维方案。</h2>
          <div class="cols">
            <div>
              <h4>四道关口，先写准则</h4>
              <ol>{gates.map((g) => <li>{g}</li>)}</ol>
            </div>
            <div>
              <h4>三档运维</h4>
              <ul>{tiers.map((t) => <li>{t}</li>)}</ul>
            </div>
          </div>
          <p>我们编写测试规范和验收准则，培训并认定现场团队，保管记录。受监管的现场作业由有资质、有保险的合作公司按该规范执行。</p>
          <span class="more">现场检测、验证与运维 →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="eyebrow">服务背后的能力</div>
      <h2>每一项都可以单独委托。</h2>
      <p class="muted" style="max-width:60ch">调试往往是第一次合作，对象是别人建的系统。设计和集成，是把<a href="/platform">产品</a>页上的四类产品连成一条回路的方式。</p>
      <div class="grid c2" style="margin-top:1.5rem">
        {services.map((s, i) => <Card href={`/services/${s.slug}`} num={String(i + 1).padStart(2, '0')} title={s.title}>{s.summary}</Card>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .field .card-img img { aspect-ratio: 16 / 9; }
  @media (min-width: 820px) { .field .card-img img { aspect-ratio: auto; } .field-body { --card-pad: var(--sp-6); } }
  .field-body h2 { font-size: var(--fs-lg); margin: 0; }
  .field-body .cols { display: grid; gap: 1rem 2rem; grid-template-columns: 1fr; margin: 0.4rem 0 0.6rem; }
  @media (min-width: 600px) { .field-body .cols { grid-template-columns: 1fr 1fr; } }
  .field-body h4 { margin: 0 0 0.4rem; }
  .field-body ol, .field-body ul { margin: 0; padding-left: 1.2rem; color: var(--ink-2); font-size: var(--fs-sm); }
  .field-body li { margin-bottom: 0.25rem; }
  .field-body p { margin: 0; color: var(--ink-2); }
</style>
