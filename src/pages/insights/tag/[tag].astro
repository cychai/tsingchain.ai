---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('insights', (p) => !p.data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---
<Base title={`洞察：${tag}`} description={`话题「${tag}」下的文章。`}>
  <PageHero eyebrow="洞察 · 话题" title={tag!} crumbs={[['/insights', '洞察']]} />
  <section class="section"><div class="narrow">
    {posts.map((p) => (
      <article class="post"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time><div><h3><a href={`/insights/${p.id}`}>{p.data.title}</a></h3>{p.data.subtitle && <p>{p.data.subtitle}</p>}</div></article>
    ))}
  </div></section>
</Base>
