---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const groups = [
  { href: '/approach', title: '技术方法', lede: '我们如何决定造什么、测什么、记什么。', links: [
    ['/approach/thermal-path', '整条热通路：六个边界'],
    ['/approach/return-water', '回水品位，以及谁能买这份热'],
    ['/approach/three-clocks', '漏液风险的三个时钟'],
  ] },
  { href: '/evidence', title: '交付证据', lede: '我们交付什么，以及按什么准则测试。', links: [
    ['/evidence/commissioning', '调试与验收准则'],
    ['/evidence/turnover', '交付资料包'],
    ['/evidence/samples', '记录样例（模板）'],
    ['/evidence/leak-points', '十大漏点'],
    ['/evidence/standards', '标准工作'],
  ] },
  { href: '/tools', title: '工具', lede: '在找我们或任何人之前，先自己核一遍数字。', links: [
    ['https://sim.nextgenergy.ai/', '液冷仿真台'],
    ['https://sim.nextgenergy.ai/catalog/', 'CDU 与设备目录'],
    ['/tools/return-water', '回水品位 → 余热买家'],
    ['/tools/approach-temp', 'CDU 趋近温差与自由冷却估算'],
    ['/tools/leak-checklist', '交付资料自查'],
  ] },
  { href: '/insights', title: '洞察', lede: '关于电力、液冷与余热利用的长文。', links: posts.map((p) => [`/insights/${p.id}`, p.data.title]) },
];
---
<Base title="资源" description="清链科技资源：液冷技术方法、交付证据、工程工具与长文。">
  <PageHero eyebrow="资源" title="技术方法、交付证据、工具与洞察。" lede="产品与现场服务背后的思路和记录，以及我们自己在用的工具。" />
  <section class="section">
    <div class="wrap">
      <div class="hub">
        {groups.map((g) => (
          <div class="hub-card">
            <h2><a href={g.href}>{g.title}</a></h2>
            <p class="muted">{g.lede}</p>
            <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
            <a class="more" href={g.href}>全部{g.title} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .hub { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .hub { grid-template-columns: 1fr 1fr; } }
  .hub-card { background: var(--white); border: 1px solid var(--line-2); border-radius: var(--r); padding: 2rem; display: flex; flex-direction: column; }
  .hub-card h2 { font-size: 1.5rem; margin: 0 0 0.4rem; }
  .hub-card h2 a { color: var(--ink); text-decoration: none; }
  .hub-card p { margin: 0 0 1rem; }
  .hub-card ul { list-style: none; padding: 0; margin: 0 0 1rem; }
  .hub-card li { border-top: 1px solid var(--line-2); }
  .hub-card li a { display: block; padding: 0.65rem 0; text-decoration: none; color: var(--ink); }
  .hub-card li a:hover { color: var(--water); }
  .hub-card .more { margin-top: auto; font-size: 0.9rem; font-weight: 600; color: var(--water); text-decoration: none; }
</style>
