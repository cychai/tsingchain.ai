---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Claim from '@/components/Claim.astro';
import Related from '@/components/Related.astro';
import { cases, caseFields } from '@/data/cases';
import Faq from '@/components/Faq.astro';
import { faqs } from '@/data/geo';
import { caseListLd, faqLd } from '@/lib/ld';
const path = '/cases';
const qa = faqs[path];
const ld = [caseListLd(path, cases), faqLd(path, qa)];
---
<Base ld={ld} title="项目案例" description="清链科技液冷与余热利用项目案例：10 MW 极端气候液冷算力中心、25 MW 城镇供热、5 MW 工业楼宇供暖、12 MW 恒温水产养殖。">
  <PageHero eyebrow="项目案例" title="规模化落地验证" lede="自 2020 年第一代浸没式液冷至 2026 年一季度，累计交付液冷设备近 1000 MW（指设备交付容量，不等于在运容量）。以下为可公开的代表性项目，均位于亚洲，每个项目按同样六栏说明；没有公开的信息注明「签署保密协议后说明」；系统图与验收记录不公开。" />
  <section class="section">
    <div class="wrap">
      <div class="grid c2">
        {cases.map((c) => (
          <div class="case">
            <div class="kpi"><b>{c.mw}</b><span>MW · {c.type}</span></div>
            <div class="body">
              <span class="tag">{c.tag}</span>
              <h3 style="margin:0">{c.title}</h3>
              <dl class="six">{caseFields.map(([k, l]) => <><dt>{l}</dt><dd>{c[k]}</dd></>)}</dl>
            </div>
            <div class="meta"><span>{c.year} 年 · {c.region}</span><span>项目方名称按约定不公开</span></div>
          </div>
        ))}
      </div>
      <div style="margin-top:2.5rem;max-width:44em">
        <Claim id="capacity-1000mw" block />
        <Claim id="case-10mw-extreme" block />
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap prose">
      <p class="small muted">口径说明：MW 数按 IT 侧热负荷计，衡量的是交付设备对应的规模，不是供热结果；供热面积按合同面积计，气温为项目所在地的极端气温记录；「项目方反馈」来自项目方；水产项目的池温为项目运行记录中的实测值，运行记录未公开。项目方名称按保密约定不公开；系统图、验收记录与运行记录不公开，项目细节签署保密协议后说明。</p>
      <Related items={[{ href: '/solutions/heat-reuse', label: '余热利用与城镇供热方案', kind: 'approach' }, { href: '/tools/return-water', label: '算一算您的余热能卖给谁', kind: 'tool' }, { href: '/evidence/turnover', label: '我们交付时移交哪些记录', kind: 'evidence' }]} />
    </div>
  </section>
  <Faq items={qa} />
</Base>

<style>
  .six { margin: 0.5rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0.1rem; font-size: 0.93rem; }
  .six dt { color: var(--ink-3); font-size: 0.8rem; font-weight: 600; }
  .six dd { margin: 0; color: var(--ink-2); }
  .six dd + dt { margin-top: 0.55rem; }
</style>
