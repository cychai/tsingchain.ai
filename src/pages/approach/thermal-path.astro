---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Related from '@/components/Related.astro';
import Definition from '@/components/Definition.astro';
import Faq from '@/components/Faq.astro';
import { definitions, faqs } from '@/data/geo';
import { definedTermLd, techArticleLd, faqLd } from '@/lib/ld';
const bounds = [
  { t: '设施水接口', who: '设施机电承包商', p: '建筑把水交给冷却系统的地方。供回水温度、流量、压力和水化学在这里确定，任何能源再利用数字将来被审计时依据的计量边界也在这里。', q: '这个边界上的流量和供回水温度，从第一天起就有表吗？' },
  { t: '排热与再利用', who: '干冷器 / 冷却塔 / 热泵厂商，或余热买家', p: '热离开站点的地方：排到空气、随蒸发带走，或者卖给买家。回路的回水品位决定了这三条路里哪几条在物理上走得通。PUE、WUE 和 ERF 在这里开始互相打架。', q: '实际消耗的是哪种资源，记在谁的表上？' },
  { t: 'CDU 与二次回路', who: 'CDU 厂商、集成商', p: '设施水与技术冷却回路之间的换热器。它的趋近温差决定了给定设施供水下二次回路必须运行得多热，也就决定了站点能拿到多少自由冷却小时。泵轴封、垫片和过滤器壳体是封闭的漏液边界。', q: '额定负荷下的趋近温差，含污垢裕量，调试时记录了吗？' },
  { t: '机柜分水器与快接', who: '机柜集成商、快接供应商', p: '系统里可拆接头数量最多的地方，也是每次换服务器都要被扰动的地方。断开的快接不等于密封的快接。首次充液的清洁度是防漏措施，不是打扫卫生。', q: '每次扰动之后都有检漏和清洁度记录，而不只是交付那一次？' },
  { t: '软管、扣压与管件', who: '软管总成厂、机柜集成商', p: '扣压是一道受控制造工序，不是装配动作。套筒压上之后，多数缺陷从外面看不见。弹性体选型决定一个干燥接头到第四年还干不干。', q: '有扣压工艺记录和弹性体规格，而不是一句「与水兼容」？' },
  { t: '冷板与芯片', who: '冷板厂商、服务器 OEM', p: '钎焊缝、搅拌摩擦焊缝、盖板与接口，就在系统中最窄流道的正上游。这里的热性能取决于上游的一切：流量、进水温度和工质清洁度。', q: '出厂压力试验记录可以追溯到这块冷板的序列号吗？' },
];
const path = '/approach/thermal-path';
const d = definitions[path];
const qa = faqs[path];
const ld = [definedTermLd(path, d), techArticleLd(path, { headline: '从设施水接口到芯片：六个边界', description: '从设施水接口到芯片：液冷系统的六个边界，各由谁负责，以及每份交付资料该为它回答的那个问题。', about: 'term' }), faqLd(path, qa)];
---
<Base ld={ld} title="整条热通路" description="从设施水接口到芯片：液冷系统的六个边界，各由谁负责，以及每份交付资料该为它回答的那个问题。">
  <PageHero eyebrow="技术方法 · 01" title="从设施水接口到芯片：六个边界" lede="热只往一个方向走，责任却通常停在每家供应商的法兰上。下面是我们画的这条路，标注了每个边界通常由谁制造，以及我们对它提的那一个问题。" crumbs={[['/approach', '技术方法']]} />
  <Definition d={d} />
  <section class="section">
    <div class="wrap">
      <div class="split">
        <div class="sticky">
          <div class="eyebrow">按下游方向读</div>
          <p class="muted">边界从设施侧向内编号，这是调试团队巡检的方向，也是水化学传播的方向。每一条列出通常制造该边界的一方，以及它的记录应回答的那一个问题。</p>
          <p class="muted small">设计讨论时刻意只分六段。专门针对漏液风险，同一条路我们拆成<a href="/evidence/leak-points">十大漏点</a>。</p>
        </div>
        <ol class="bounds">
          {bounds.map((b) => (
            <li>
              <div>
                <h3>{b.t}</h3>
                <p class="small muted" style="margin-bottom:0.4rem">通常由谁制造：{b.who}</p>
                <p>{b.p}</p>
                <p class="q">→ {b.q}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap prose">
      <h2>为什么记录必须跟着热走</h2>
      <p>重点不是工厂做的接头永远不漏，而是在受控条件下做出来的边界，可以按明确的验收判据测试、记录、放行。凌晨两点在带电机房里做出来的边界，理应拿到同样的证据。当这些记录分散在六家单位的六种格式里，运维方接手的就是一套谁也无法公开辩护的系统。</p>
      <p>我们的工作是在书面约定的范围内守住这条线：跨越六个边界做设计，规定每个边界必须证明什么，再把记录汇成一份随系统进入服役期的<a href="/evidence/turnover">交付资料包</a>。</p>
      <Related items={[{ href: '/evidence/leak-points', label: '同一条路上的十大漏点', kind: 'evidence' }, { href: '/evidence/turnover', label: '交付资料包包含什么', kind: 'evidence' }, { href: '/tools/approach-temp', label: '趋近温差与 CDU 选型', kind: 'tool' }]} />
    </div>
  </section>
  <Faq items={qa} />
</Base>
