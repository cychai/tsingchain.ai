---
import '@/styles/fonts.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  published?: Date;
}
const { title, description = site.description, canonical, type = 'website', published } = Astro.props;
const fullTitle = title === site.name ? `${site.name} | ${site.headline}` : `${title} | ${site.name} · ${site.tagline}`;
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const url = new URL(cleanPath, Astro.site);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${Astro.site}#org`, name: site.name, alternateName: site.nameEn, legalName: site.legalName, url: String(Astro.site), logo: new URL('/brand/emblem-512.png', Astro.site).href, description: site.headline, foundingDate: String(site.founded), address: { '@type': 'PostalAddress', addressLocality: '北京', addressCountry: 'CN' }, email: site.email, founder: { '@type': 'Person', name: '王辉', jobTitle: '创始人兼 CEO' }, sameAs: [site.overseas.url, site.substack], knowsAbout: ['数据中心液冷', '冷板式液冷', '浸没式液冷', 'CDU', '余热回收', '城镇供热', '回水品位'] },
    { '@type': 'WebSite', '@id': `${Astro.site}#website`, url: String(Astro.site), name: site.name, publisher: { '@id': `${Astro.site}#org` }, inLanguage: 'zh-CN' },
    { '@type': 'WebPage', url: url.href, name: fullTitle, description, isPartOf: { '@id': `${Astro.site}#website` }, ...(published ? { datePublished: published.toISOString() } : {}) },
  ],
});
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical ?? url.href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/emblem-512.png" />
    <meta property="og:image" content="/brand/emblem-512.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 洞察`} href="/insights/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url.href} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <Header />
    <noscript><div class="noscript wrap">本站除三个在线工具和手机端菜单外，无需 JavaScript 即可浏览。全部栏目链接见页脚。</div></noscript>
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
