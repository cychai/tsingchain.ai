{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsingchain-ai",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  // 自定义域名在 Cloudflare 里确认 tsingchain.ai 这个 zone 已激活后再打开：
  // "routes": [
  //   { "pattern": "tsingchain.ai", "custom_domain": true },
  //   { "pattern": "www.tsingchain.ai", "custom_domain": true }
  // ],
  // Cloudflare Workers Builds 在每次推送 main 时执行 `npx wrangler deploy`；
  // Wrangler 会先跑下面的构建命令，再把 ./dist 作为静态资产上传。
  "build": { "command": "npm ci && npm run build" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
